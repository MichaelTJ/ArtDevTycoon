# Copy to `.env` and adjust. Never commit `.env`.

# Which AI backend to use.
#   mock    - deterministic placeholders, instant, no models required (default)
#   sidecar - real SDXL-Turbo + Janus-Pro-1B via the local Python service
#   auto    - probe the sidecar, fall back to mock if it is not running
AI_PROVIDER=mock

# Base URL of the Python sidecar. Only used when AI_PROVIDER is sidecar or auto.
SIDECAR_URL=http://127.0.0.1:8756

# Milliseconds before a generation request is abandoned. SDXL-Turbo needs roughly
# 2-3s warm on the Arc iGPU, but the very first call also pays model load time.
SIDECAR_TIMEOUT_MS=120000
